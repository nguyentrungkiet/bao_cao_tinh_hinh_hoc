# Telegram Bot Configuration
# Lấy token từ @BotFather trên Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Ví dụ:
# TELEGRAM_BOT_TOKEN=1234567890:ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefg

# HƯỚNG DẪN:
# 1. Copy file này thành '.env'
# 2. Thay thế 'your_telegram_bot_token_here' bằng token thật của bot
# 3. KHÔNG commit file .env lên repository!